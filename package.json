{
  "name": "cant-jack-out",
  "private": true,
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/poeticmatter/CantJackOut"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stats": "tsx src/sim/cantStopStats.ts",
    "stats:pairing": "tsx src/sim/pairingStats.ts",
    "calibrate": "tsx src/sim/calibrate.ts",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
